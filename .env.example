# Provider order is tried from left to right. Providers without keys are skipped.
LLM_PROVIDERS=gemini,groq,mistral,cerebras,openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Any OpenAI-compatible endpoint works (default is Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
NEWSAPI_KEY=
GOOGLE_FACTCHECK_API_KEY=

# Optional tuning
MAX_STEPS=4
MAX_PAGE_CHARS=4000
MAX_CONTEXT_CHARS=6000
REQUEST_TIMEOUT=20
MAX_RESEARCH_SECONDS=90
TIMEZONE=Asia/Kolkata
CACHE_TTL_SECONDS=3600
